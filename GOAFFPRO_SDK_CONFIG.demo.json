{
  "base": {
    "url": "https://lightgoldenrodyellow-okapi-586794.hostingersite.com/kishan/demo_clone/api",
    "auth": {},
    "headers": {
      "Content-Type": "application/json"
    }
  },
  "getProducts": {
    "url": "/products?search={{keyword}}",
    "method": "get"
  },
  "createDiscountCode": {
    "url": "/coupons",
    "method": "post"
  },
